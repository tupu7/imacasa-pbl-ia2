# ============================================================
# IMACASA PC12 — Variables de entorno
# ============================================================
# Copia este archivo como .env y reemplaza TODOS los valores.
#   PowerShell:  Copy-Item .env.example .env
# NO subas .env a Git ni compartas los valores reales.
# ============================================================

# --- MOCK (servicio de evaluación del checkpoint) ---
# Nombre del equipo que aparece en GET /info
TEAM=Equipo XX

# Credenciales HTTP Basic para GET /info
# Usa valores únicos; no reutilices estos ejemplos.
API_USER=equipoXX
API_PASS=cambia-por-una-clave-larga

# --- APP (interfaz de inspección) ---
# Secreto para firmar tokens de sesión. Mínimo 32 caracteres aleatorios.
# Ejemplo para generar uno en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
APP_SECRET=reemplaza-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Usuarios de la interfaz web.
# Formato: usuario:clave:rol,usuario2:clave2:rol2
# Roles válidos: operador, calidad, admin
APP_USERS=operador:cambia-clave-operador:operador,calidad:cambia-clave-calidad:calidad
